{
  "datasets": [
    {
      "name": "cc6211a6",
      "displayName": "gold_daily_hires",
      "config": {
        "version": "1.1",
        "source": "workspace.tfl_lakehouse.gold_daily_hires",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_hires",
            "expr": "SUM(`hires`)"
          },
          {
            "name": "avg_ride_duration",
            "expr": "AVG(`avg_duration_mins`)",
            "displayName": "Avg Ride Duration (mins)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "busiest_day_hires",
            "expr": "MAX(`hires`)",
            "displayName": "Hires on Busiest Day"
          },
          {
            "name": "last_updated",
            "expr": "MAX(`hire_date`)",
            "displayName": "Data Last Updated",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          }
        ]
      }
    },
    {
      "name": "44a5379a",
      "displayName": "gold_popular_routes",
      "config": {
        "version": "1.1",
        "source": "workspace.tfl_lakehouse.gold_popular_routes",
        "dimensions": [
          {
            "name": "route",
            "expr": "CONCAT(`start_station_name`, ' to ', `end_station_name`)"
          }
        ],
        "measures": [
          {
            "name": "total_journeys",
            "expr": "SUM(`total_journeys`)"
          },
          {
            "name": "avg_ride_duration",
            "expr": "SUM(`total_journeys` * `avg_duration_mins`) / NULLIF(SUM(`total_journeys`), 0)",
            "displayName": "Avg Ride Duration (mins)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "611f1fb3",
      "displayName": "gold_station_activity",
      "config": {
        "version": "1.1",
        "source": "workspace.tfl_lakehouse.gold_station_activity",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "3a809b34",
      "displayName": "silver",
      "config": {
        "version": "1.1",
        "source": "workspace.tfl_lakehouse.silver",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "day_of_week",
            "expr": "DATE_FORMAT(`start_timestamp`, 'EEEE')"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
